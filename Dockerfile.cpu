# dec-serve solo CPU. Construir:  docker build -f Dockerfile.cpu -t ours-dec:cpu .
# Correr:  docker run -p 127.0.0.1:8090:8090 -v ./pool:/pool -v hf-cache:/models ours-dec:cpu --pool-dir /pool --device cpu
FROM python:3.11.10-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/models

WORKDIR /app
# torch de CPU (≈ 200 MB en vez de ≈ 2.5 GB del build CUDA)
RUN pip install "torch>=2.6,<2.7" --index-url https://download.pytorch.org/whl/cpu
COPY pyproject.toml LICENSE THIRD_PARTY_NOTICES.md ./
COPY src ./src
RUN pip install .

RUN useradd --create-home --uid 1000 dec \
 && mkdir -p /models /pool \
 && chown dec:dec /models /pool
USER dec
VOLUME ["/models"]
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --start-period=300s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/health', timeout=4)"]
ENTRYPOINT ["dec-serve", "--host", "0.0.0.0", "--port", "8090"]
CMD ["--pool-dir", "/pool", "--device", "cpu"]
